# Sepolia deployment (Hardhat)
# Get a free RPC URL from Alchemy, Infura or QuickNode.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Private key of the deployer wallet (MetaMask > Account details > Show private key).
# NEVER commit the resulting .env file.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Optional: Etherscan API key for `npx hardhat verify`.
ETHERSCAN_API_KEY=

# Optional: address that receives marketplace fees (defaults to the deployer).
TREASURY_ADDRESS=

# Optional: extra account allowed to mint credit batches.
ISSUER_ADDRESS=
